AAD//AAAf/gAAD/8AA/+/AAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "Dark-eyed Junco", "sci": "Junco hyemalis", "n": 38, "first": "9:47 AM", "last": "2:48 PM", "ts": 1793976458, "mins": [587, 592, 592, 595, 608, 646, 650, 651, 651, 658, 659, 671, 673, 691, 693, 694, 698, 747, 749, 765, 782, 782, 783, 783, 784, 784, 787, 878, 879, 879, 880, 881, 883, 884, 884, 887, 888, 888], "anim": null, "trunk": false, "fact": "Often called “snowbirds” because they show up as winter arrives. The white outer tail feathers flash as they flit away.", "vox": "sounds/voice/junco-hyemalis.mp3?v=1793113009", "snd": "sounds/junco-hyemalis.mp3?v=1793113154", "sndby": "Phoenix Birder, xeno-canto XC563632, CC BY-NC-SA 4.0", "key": "junco", "cm": 15.5, "img": "cutouts/junco.png?v=1793991313", "w": 534, "h": 447, "len": 625.0, "v": 1793991313, "beak": [0.022, 0.14, "L"], "mask": {"c": 32, "r": 27, "b": "D4AAAD/AAAA/4AAA//AAAP/wAAA//AAAH/4AAD//AAA//4AAP//AAD//4AA///AAH//4wB///cAP//+AB///AAf//wAB//+AAP//wAA//8AAH+PgAD8B8AH+AHgD/gA8D+AAHg/gAA8AAAAH"}}, {"name": "Eastern Bluebird", "sci": "Sialia sialis", "n": 3, "first": "9:50 AM", "last": "1:13 PM", "ts": 1793976609, "mins": [590, 661, 793], "anim": null, "trunk": false, "fact": "Bluebirds nest in tree cavities, and their numbers crashed in the early 1900s when starlings and house sparrows took the holes. Volunteer nest-box trails helped them rebound.", "vox": "sounds/voice/sialia-sialis.mp3?v=1793113046", "snd": "sounds/sialia-sialis.mp3?v=1793113130", "sndby": "Robin Carter, xeno-canto XC1374, CC BY-NC-ND 2.5", "key": "bluebird", "cm": 18.0, "img": "cutouts/bluebird.png?v=1793990893", "w": 649, "h": 609, "len": 744.0, "v": 1793990893, "beak": [0.851, 0.1, "R"], "mask": {"c": 32, "r": 30, "b": "AAA/AAAA/4AAAP/wAAH/4AAD/4AAA/+AAAP/gAAH/4AAD/+AAA//gAAf/4AAP/+AAD//gAB//4AA//8AAf/+AgH//g4D//w8A//48Af/98AP//8AH8b8AB8P8AAcPzAAOfgwAHPgAADvgAAA3gAAAHgAAABwAAAA"}}, {"name": "Bald Eagle", "sci": "Haliaeetus leucocephalus", "n": 1, "first": "9:50 AM", "last": "9:50 AM", "ts": 1793976646, "mins": [590], "anim": null, "trunk": false, "fact": "Bald Eagles add to the same nest year after year, so some grow into the biggest nests of any North American bird: hundreds of pounds of sticks.", "vox": "sounds/voice/haliaeetus-leucocephalus.mp3?v=1793113008", "snd": "sounds/haliaeetus-leucocephalus.mp3?v=1793113183", "sndby": "Ryan P. O&#039;Donnell, xeno-canto XC81952, CC BY-NC-ND 2.5", "key": "baldeagle", "cm": 63.0, "img": "cutouts/baldeagle.png?v=1793977259", "w": 383, "h": 577, "len": 490.0, "v": 1793977259, "beak": [0.012, 0.085, "L"], "mask": {"c": 32, "r": 48, "b": "D8AAAB/gAAB/8AAA//AAAP/4AAD//AAAh/8AAAP/wAAD//gAA//+AAP//4AH///AD///4A///+AP///wD///8A////gP///4B///+Af///wD///8A////AH///wA///8AD///gAf//4AD//8AA+//AAPP/4AB3/+AAf//wAH//8AB///AA/6fwAP+AAAD/gAAA/8AAAH/AAAD/wAAAf8AAAH+AAAB/gAAAf4AAAH/AAAB/wAAAP8AAAAAAAAAAAA"}}, {"name": "Blue Jay", "sci": "Cyanocitta cristata", "n": 4, "first": "9:52 AM", "last": "11:06 AM", "ts": 1793976752, "mins": [592, 594, 636, 666], "anim": null, "trunk": false, "fact": "That blue isn’t a pigment. Tiny structures in the feathers scatter light, which is why a crushed blue feather looks brown. Jays also bury acorns and help spread oak trees.", "vox": "sounds/voice/cyanocitta-cristata.mp3?v=1793112993", "snd": "sounds/cyanocitta-cristata.mp3?v=1793113328", "sndby": "Christopher McPherson, xeno-canto XC691163, CC BY-NC-SA 4.0", "key": "bluejay", "cm": 28.0, "img": "cutouts/bluejay.png?v=1793031427", "w": 385, "h": 369, "len": 474.0, "v": 1793031427, "beak": [0.99, 0.17, "R"], "mask": {"c": 32, "r": 31, "b": "AAAPgAAAD+AAAA/4AAAH+AAAD/8AAB//AAA//gAAf/AAAP/wAAH/8AAD//AAB//wAB//4AAf/+AAf//gAH//zAD//5wA//94Af+OcAP/8eAD9/fgA/l/gAPgHwAHgD4AHwA4AB8AeAA+AGAAfADgAHgAwADwAAAA4AAAAA=="}}, {"name": "Red-shouldered Hawk", "sci": "Buteo lineatus", "n": 2, "first": "9:53 AM", "last": "10:52 AM", "ts": 1793976823, "mins": [593, 652], "anim": null, "trunk": false, "fact": "Its loud, repeated kee-ah call i