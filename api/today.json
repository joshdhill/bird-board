{"birds": [{"name": "House Finch", "sci": "Haemorhous mexicanus", "n": 106, "first": "8:17 AM", "last": "5:16 PM", "ts": 1793103447, "mins": [497, 500, 501, 502, 502, 503, 505, 506, 506, 507, 509, 510, 511, 511, 512, 512, 513, 514, 518, 519, 522, 528, 529, 530, 534, 534, 535, 538, 538, 542, 543, 543, 544, 545, 546, 546, 547, 547, 548, 548, 548, 549, 549, 550, 550, 551, 551, 552, 552, 553, 554, 554, 554, 555, 556, 558, 558, 560, 563, 568, 569, 569, 570, 571, 572, 573, 577, 578, 579, 581, 583, 584, 585, 585, 585, 586, 588, 588, 589, 589, 596, 606, 616, 620, 623, 628, 634, 651, 654, 691, 722, 724, 775, 777, 806, 861, 862, 904, 910, 911, 917, 918, 988, 1029, 1036, 1036], "anim": null, "trunk": false, "fact": "Native to the West, house finches were released on Long Island in 1940 as pet-shop “Hollywood finches” and spread across the East. Redder males are favored by females.", "vox": "sounds/voice/haemorhous-mexicanus.mp3?v=1793113005", "snd": "sounds/haemorhous-mexicanus.mp3?v=1793113108", "sndby": "Ted Floyd, xeno-canto XC622745, CC BY-NC-SA 4.0", "key": "housefinch", "cm": 14.0, "img": "cutouts/housefinch.png", "w": 800, "h": 581, "len": 662.0, "beak": [0.12, 0.13, "L"], "mask": {"c": 32, "r": 23, "b": "A+AAAAfwAQoP8AHOH/gB7wf8Af8D/gH/B/8A3wf/AP4H/4zgB//fwAP/zwAD//4AAf/+AAD/9AAAf/gAAD/8AA/+fAAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "American Goldfinch", "sci": "Spinus tristis", "n": 19, "first": "8:18 AM", "last": "5:42 PM", "ts": 1793103531, "mins": [498, 501, 512, 539, 552, 556, 558, 569, 570, 570, 572, 586, 591, 648, 648, 803, 849, 860, 1062], "anim": null, "trunk": false, "fact": "One of the strictest vegetarians among birds. Goldfinches nest late in summer, when thistle seeds are ripe, and swap bright yellow for olive-brown in winter.", "vox": "sounds/voice/spinus-tristis.mp3?v=1793113053", "snd": "sounds/spinus-tristis.mp3?v=1793113090", "sndby": "Will Sweet, xeno-canto XC453934, CC BY-NC-SA 4.0", "key": "goldfinch", "cm": 12.0, "img": "cutouts/goldfinch.png", "w": 517, "h": 369, "len": 415.0, "beak": [0.18, 0.15, "L"], "mask": {"c": 32, "r": 23, "b": "APAAAAH4AAAD/AAAB/wAAAH+AAEB/wADAf+ADgH/wBwB/8BwAf/h4AD/84AA//4AAH/8AAA/+AAAH/wAAA/+AAA/PgAAeA8AAfgHgAegB8AOAANAPAAAADgAAAA="}}, {"name": "Carolina Chickadee", "sci": "Poecile carolinensis", "n": 101, "first": "8:19 AM", "last": "6:03 PM", "ts": 1793103552, "mins": [499, 499, 499, 502, 504, 508, 512, 512, 514, 515, 517, 517, 518, 519, 521, 522, 525, 526, 529, 536, 546, 549, 550, 555, 556, 562, 565, 570, 570, 571, 584, 584, 598, 600, 602, 605, 608, 608, 610, 629, 630, 632, 632, 633, 633, 634, 635, 646, 663, 679, 679, 710, 710, 711, 712, 712, 713, 714, 716, 721, 722, 732, 743, 744, 744, 749, 751, 753, 755, 759, 763, 797, 801, 802, 803, 805, 806, 808, 816, 817, 819, 820, 852, 852, 854, 855, 865, 876, 876, 877, 878, 880, 884, 900, 923, 924, 925, 933, 954, 998, 1083], "anim": null, "trunk": false, "fact": "Chickadees hide seeds in many separate spots and can remember where for weeks, then dig them back out when food gets scarce.", "vox": "sounds/voice/poecile-carolinensis.mp3?v=1793113028", "snd": "sounds/poecile-carolinensis.mp3?v=1793113078", "sndby": "J.R. Rigby, xeno-canto XC309925, CC BY-NC-SA 4.0", "key": "chickadee", "cm": 12.5, "img": "cutouts/chickadee.png", "w": 686, "h": 800, "len": 829.0, "beak": [0.78, 0.05, "R"], "mask": {"c": 32, "r": 37, "b": "AAB+AQAA/8MAAf+DAAP/AwAD/wYAA/8EAAf/NAAH/zwAB/98AA//+AAP//4AH/+/AD//PgA//38Af/98AH//5AD//sAA//3AAf/9gAH//4AD//+AA///gAf//4AHg/wADgH4ABwA+AA4APAAcAH4AHAB8ADgA9AAwAeAAIAPAAAAHwAAABwAAAA4AAAAeAAAADAAAA=="}}, {"name": "Carolina Wren", "sci": "Thryothorus ludovicianus", "n": 6, "first": "8:22 AM", "last": "6:14 PM", "ts": 1793103744, "mins": [502, 563, 564, 846, 847, 1094], "anim": null, "trunk": false, "fact": "Its song sounds like “teakettle, teakettle, teakettle,” and pairs often sing duets. It will nest in odd places: flowerpots, mailboxes, even old boots.", "vox": "sounds/voice/thryothorus-ludovicianus.mp3?v=1793113060", "snd": "sounds/thryothorus-ludovicianus.mp3?v=1793113075", "sndby": "Jacob Saucier, xeno-canto XC498646, CC BY-NC-SA 4.0", "life": true, "key": "wren", "cm": 13.0, "img": "cutouts/wren.png", "w": 800, "h": 633, "len": 781.0, "beak": [0.85, 0.21, "R"], "mask": {"c": 32, "r": 25, "b": "MAAAADgAAAA8AAAAHAB+AB4A/8APA//gBx//AAf//gAH//4AB//+AAf//AAH//wAD//4AAP/8AAB/+H/AP/f/wA///8AGf+MAB/zAA7/4AAP/4AAP/4AAP9gAAD4AAAAcAAAAA=="}}, {"name": "Tufted Titmouse", "sci": "Baeolophus bicolor", "n": 39, "first": "8:24 AM", "last": "4:54 PM", "ts": 1793103862, "mins": [504, 517, 523, 527, 528, 531, 536, 560, 561, 564, 564, 567, 569, 569, 577, 579, 601, 602, 608, 609, 622, 642, 644, 645, 683, 684, 687, 743, 789, 791, 956, 962, 965, 966, 967, 968, 968, 1009, 1014], "anim": null, "trunk": false, "fact": "Titmice line their nests with hair, and they have been seen plucking it from live raccoons, dogs, and even people.", "vox": "sounds/voice/baeolophus-bicolor.mp3?v=1793112971", "snd": "sounds/baeolophus-bicolor.mp3?v=1793113083", "sndby": "Jim Berry, xeno-canto XC649331, CC BY-NC-SA 4.0", "key": "titmouse", "cm": 16.5, "img": "cutouts/titmouse.png", "w": 574, "h": 800, "len": 653.0, "beak": [0.2, 0.25, "L"], "mask": {"c": 32, "r": 45, "b": "cAAAAHAAAAAwAAAAIAAAAGgBAAA8BwAAPB8AAD4/AAAcf4AAWP+AAHv/wAB7/8AA+P/AANhH4AAbH/AADz/wAA9/+AAPP/wABD/8AB6//gAO//4ABt//AAfP/wAHx/+AB+P/gAPh/4ADiP/AB4Z/wAeH/+AHofvgBPOB8AD3APgAfAB4APgAPAD4AB4A+AAeAPwADwA3AA8ANgAGAD4AAAAeAAAAGgAAABgAAAAMAAAADAAA"}}, {"name": "Dark-eyed Junco", "sci": "Junco hyemalis", "n": 6, "first": "8:27 AM", "last": "9:45 AM", "ts": 1793104069, "mins": [507, 509, 519, 532, 538, 585], "anim": null, "trunk": false, "fact": "Often called “snowbirds” because they show up as winter arrives. The white outer tail feathers flash as they flit away.", "vox": "sounds/voice/junco-hyemalis.mp3?v=1793113009", "snd": "sounds/junco-hyemalis.mp3?v=1793113154", "sndby": "Phoenix Birder, xeno-canto XC563632, CC BY-NC-SA 4.0", "life": true, "key": "junco", "cm": 15.5, "img": "cutouts/junco.png", "w": 800, "h": 562, "len": 625.0, "beak": [0.2, 0.22, "L"], "mask": {"c": 32, "r": 22, "b": "AAAABgAAAAYA8AAMAfgAGAP8ADAD/gAhAf8AZwH/gMwB/8G4Af/h8AD/84AA//4AAH/8AAA//gAAH/4AAAfvAAAPh4AEPwHABfgA4A/QAGA+AAAA8AAAAA=="}}, {"name": "Northern Cardinal", "sci": "Cardinalis cardinalis", "n": 9, "first": "8:31 AM", "last": "4:00 PM", "ts": 1793104306, "mins": [511, 524, 525, 640, 640, 641, 911, 960, 960], "anim": null, "trunk": false, "fact": "Female cardinals sing too, which is unusual for a North American songbird. During courtship the male feeds her seeds beak to beak.", "vox": "sounds/voice/cardinalis-cardinalis.mp3?v=1793112978", "snd": "sounds/cardinalis-cardinalis.mp3?v=1793113085", "sndby": "David Tattersley, xeno-canto XC1000248, CC BY-NC-SA 4.0", "life": true, "key": "cardinal", "cm": 22.0, "img": "cutouts/cardinal.png", "w": 516, "h": 348, "len": 530.0, "beak": [0.06, 0.28, "L"], "mask": {"c": 32, "r": 22, "b": "AYAAAAeAAAAPgAAAH4AAAB/AAAA/4AAAf/gAAB/+AAAf/4AAD//AAA//4AAP//AAB//8AAf//AAD//8AAf//wAB/j/DgPzv8/f/+/x//vn945gAeMAAAAA=="}}, {"name": "Pileated Woodpecker", "sci": "Dryocopus pileatus", "n": 14, "first": "8:33 AM", "last": "5:10 PM", "ts": 1793104386, "mins": [513, 652, 764, 820, 821, 830, 830, 839, 839, 840, 845, 940, 1024, 1030], "anim": null, "trunk": false, "fact": "It chisels big rectangular holes in dead wood while hunting carpenter ants. Abandoned holes later shelter owls, ducks and other cavity nesters.", "vox": "sounds/voice/dryocopus-pileatus.mp3?v=1793112997", "snd": "sounds/dryocopus-pileatus.mp3?v=1793113171", "sndby": "Mike Nelson, xeno-canto XC102028, CC BY-NC-ND 2.5", "life": true, "key": "pileated", "cm": 45.0, "img": "cutouts/pileated.png", "w": 649, "h": 800, "len": 737.0, "beak": [0.42, 0.1, "R"], "mask": {"c": 32, "r": 39, "b": "AAAAAAAAH/4AAB/+Bzwf/x/4H/9/8B///+Af/n/AH/8/8B//D/wf/wf+H/8D/x//Af8f/gP/n/8D/5//A////wH///8B////Af///wH///4A/9/+AP/f/gD/3/4Af5/+AH+f/gA/v/4AP7//AB+//wAPv/8AD///AAf//wAH//8ABv/+AAD//gAAf/4AAH//AAA//wAAP/8AADAA"}}, {"name": "Fish Crow", "sci": "Corvus ossifragus", "n": 174, "first": "8:37 AM", "last": "5:52 PM", "ts": 1793104644, "mins": [517, 518, 519, 519, 520, 520, 521, 521, 522, 522, 523, 524, 524, 524, 525, 526, 527, 528, 528, 529, 529, 531, 531, 532, 533, 551, 556, 557, 557, 557, 570, 571, 571, 572, 572, 573, 573, 573, 574, 574, 574, 575, 575, 590, 590, 604, 605, 605, 609, 612, 612, 612, 613, 613, 614, 614, 614, 615, 615, 616, 616, 617, 617, 617, 618, 618, 618, 619, 619, 631, 633, 634, 634, 636, 636, 636, 637, 637, 638, 639, 640, 641, 641, 642, 643, 643, 644, 644, 645, 645, 646, 646, 647, 647, 648, 648, 648, 656, 656, 689, 700, 700, 701, 701, 701, 702, 702, 703, 707, 710, 710, 711, 711, 712, 713, 714, 714, 715, 715, 715, 716, 716, 716, 717, 717, 717, 718, 720, 721, 721, 721, 722, 728, 728, 729, 761, 818, 818, 818, 819, 819, 820, 820, 821, 821, 821, 822, 822, 824, 824, 824, 825, 825, 827, 860, 862, 862, 864, 864, 865, 865, 865, 866, 866, 867, 867, 867, 868, 868, 925, 1046, 1047, 1072, 1072], "anim": null, "trunk": false, "fact": "It looks just like an American Crow. The giveaway is the voice: a nasal, two-note “uh-uh” instead of a clear “caw.”", "vox": "sounds/voice/corvus-ossifragus.mp3?v=1793112991", "snd": "sounds/corvus-ossifragus.mp3?v=1793113105", "sndby": "Mike Nelson, xeno-canto XC130581, CC BY-NC-SA 3.0", "key": "fishcrow", "cm": 38.0, "img": "cutouts/fishcrow.png", "w": 800, "h": 474, "len": 557.0, "beak": [0.27, 0.08, "L"], "mask": {"c": 32, "r": 19, "b": "AHwAAAD+AAAAPwAAAB+AAAAf4AAAH/AAAB/4AAAP/AAAD/4AAAf/AAAD/4AAAf/AAAD3wH4Bs+B///Dgf////n////4AD//+AAAP/w=="}}, {"name": "Golden-crowned Kinglet", "sci": "Regulus satrapa", "n": 2, "first": "8:40 AM", "last": "8:49 AM", "ts": 1793104819, "mins": [520, 529], "anim": null, "trunk": false, "fact": "One of the tiniest songbirds here, yet it survives freezing winter nights by shivering, puffing up its feathers, and huddling with others.", "vox": "sounds/voice/regulus-satrapa.mp3?v=1793113033", "snd": "sounds/regulus-satrapa.mp3?v=1793113145", "sndby": "Mike Nelson, xeno-canto XC135597, CC BY-NC-SA 3.0", "key": "goldenkinglet", "cm": 10.0, "img": "cutouts/goldenkinglet.png", "w": 800, "h": 541, "len": 578.0, "beak": [0.9, 0.13, "R"], "mask": {"c": 32, "r": 22, "b": "AAAHwAAAH+DAAH/4YAD/8DAD/+AeB//gBw//wAOf/8AA///AAf//gAH//wAAh/wAAAHwAAAA+AAAAD4AAAAPAAAAD8AAAAHwAAAAeAAAABwAAAAPAAAAAw=="}}, {"name": "Eastern Bluebird", "sci": "Sialia sialis", "n": 20, "first": "8:40 AM", "last": "2:02 PM", "ts": 1793104824, "mins": [520, 523, 537, 537, 539, 545, 566, 566, 567, 573, 580, 598, 605, 605, 620, 645, 651, 652, 688, 842], "anim": null, "trunk": false, "fact": "Bluebirds nest in tree cavities, and their numbers crashed in the early 1900s when starlings and house sparrows took the holes. Volunteer nest-box trails helped them rebound.", "vox": "sounds/voice/sialia-sialis.mp3?v=1793113046", "snd": "sounds/sialia-sialis.mp3?v=1793113130", "sndby": "Robin Carter, xeno-canto XC1374, CC BY-NC-ND 2.5", "key": "bluebird", "cm": 18.0, "img": "cutouts/bluebird.png", "w": 800, "h": 609, "len": 744.0, "beak": [0.69, 0.1, "R"], "mask": {"c": 32, "r": 24, "b": "AAPwAAAH+AAAD/wAAA/4AAAf8AAAH/AAAD/wAAB/+AAAf/gDAP/wBgH/8BwB//BwA//g4Af/w4AH/44AD/94AB//4AA/P4AAPH0AAHPhAABngAAA3gAAAPgAAABgAAAA"}}, {"name": "White-throated Sparrow", "sci": "Zonotrichia albicollis", "n": 73, "first": "8:43 AM", "last": "5:27 PM", "ts": 1793104993, "mins": [523, 523, 530, 532, 532, 533, 533, 534, 535, 535, 539, 540, 543, 544, 552, 553, 555, 556, 557, 558, 558, 559, 559, 559, 559, 560, 561, 562, 563, 563, 564, 565, 566, 567, 567, 567, 568, 568, 575, 575, 575, 576, 576, 577, 580, 593, 598, 604, 604, 605, 606, 607, 612, 615, 639, 690, 766, 767, 782, 783, 786, 802, 806, 817, 882, 898, 898, 938, 939, 939, 970, 979, 1047], "anim": null, "trunk": false, "fact": "White-throats come in two color forms, white-striped and tan-striped, and almost always pair with the opposite form. Listen for “Oh-sweet-Canada, Canada, Canada.”", "vox": "sounds/voice/zonotrichia-albicollis.mp3?v=1793113071", "snd": "sounds/zonotrichia-albicollis.mp3?v=1793113140", "sndby": "Matt Wistrand, xeno-canto XC339648, CC BY-NC-SA 4.0", "key": "whitethroated", "cm": 17.0, "img": "cutouts/whitethroated.png", "w": 800, "h": 460, "len": 599.0, "beak": [0.73, 0.14, "R"], "mask": {"c": 32, "r": 18, "b": "AAA+AAAB/gAAB/8DAB/+BgB//hwB//44f//84P///8AAP/8AAA/8AAAD8AAAA/AAAA8AAAA/AAAAcAAAAeAAAAOAAAAHAAAA"}}, {"name": "Red-bellied Woodpecker", "sci": "Melanerpes carolinus", "n": 2, "first": "8:48 AM", "last": "8:49 AM", "ts": 1793105285, "mins": [528, 529], "anim": null, "trunk": true, "fact": "The “red belly” is only a faint pink blush you will rarely see. The red cap is the giveaway. Its barbed tongue can reach about two inches past the bill tip.", "vox": "sounds/voice/melanerpes-carolinus.mp3?v=1793113012", "snd": "sounds/melanerpes-carolinus.mp3?v=1793113332", "sndby": "Bruce Lagerquist, xeno-canto XC713255, CC BY-NC-SA 4.0", "life": true, "key": "redbellied", "cm": 24.0, "img": "cutouts/redbellied.png", "w": 400, "h": 800, "len": 516.0, "beak": [0.52, 0.23, "R"], "mask": {"c": 32, "r": 64, "b": ""}}, {"name": "Ruby-crowned Kinglet", "sci": "Corthylio calendula", "n": 2, "first": "8:57 AM", "last": "9:14 AM", "ts": 1793105856, "mins": [537, 554], "anim": null, "trunk": false, "fact": "Its ruby crown stays hidden under olive feathers until the male gets excited, then it flares up. A ruby-crowned kinglet flicks its wings constantly.", "vox": "sounds/voice/corthylio-calendula.mp3?v=1793112988", "snd": "sounds/corthylio-calendula.mp3?v=1793113143", "sndby": "Andrew Spencer, xeno-canto XC104679, CC BY-NC-ND 2.5", "key": "rubykinglet", "cm": 10.8, "img": "cutouts/rubykinglet.png", "w": 800, "h": 653, "len": 568.0, "beak": [0.09, 0.35, "L"], "mask": {"c": 32, "r": 26, "b": "AAAAAwAAAAYAAAAGAAAADAAAADgAAAAwA8AAYA/wAOAf/ADAH/8BwAf/hwAH/+YAB//8AAP//gAD//+AAf/hAAB/wAAAH4AAAD8AAAB8AAAA8AAAAfAAAA+AAAAeAAAAOAAAAPAAAAA="}}, {"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 9, "first": "9:03 AM", "last": "6:14 PM", "ts": 1793106200, "mins": [543, 555, 564, 756, 912, 1009, 1051, 1052, 1094], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png", "w": 486, "h": 800, "len": 707.0, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAAAAAAD//AAA//wAAP/8AAD//DgA//wfYH/8D/x//Af+f/wH/3/8A/9//AP/f/wB/3/8B/9//A//f/wf/n/8P/x//H/8f/5//H/+//x//v/8f////D////x////8f////H////h////4P///8D////A////wP///4D///+A////AP///wD///8A///+AP///gD///wA///4AP//8AD///AA///wAP//sAD//4AA//8AAP//AAD//gAA//4AAP/+AAB//gAA//wAAP/8AAB//AAA="}}, {"name": "White-breasted Nuthatch", "sci": "Sitta carolinensis", "n": 32, "first": "9:04 AM", "last": "4:42 PM", "ts": 1793106283, "mins": [544, 558, 593, 599, 602, 611, 612, 633, 634, 634, 635, 638, 669, 669, 669, 672, 674, 704, 704, 704, 708, 720, 775, 777, 779, 825, 839, 907, 908, 928, 964, 1002], "anim": null, "trunk": true, "fact": "Nuthatches climb down tree trunks head first. The name comes from “nut-hack”: they wedge a seed into bark and hack it open.", "vox": "sounds/voice/sitta-carolinensis.mp3?v=1793113050", "snd": "sounds/sitta-carolinensis.mp3?v=1793113095", "sndby": "Andrew Spencer, xeno-canto XC14860, CC BY-NC-ND 2.5", "key": "nuthatch", "cm": 14.0, "img": "cutouts/nuthatch.png", "w": 532, "h": 327, "len": 372.0, "beak": [0.79, 0.42, "R"], "mask": {"c": 32, "r": 20, "b": "fgAAAH8AAAB/AAAAP4AAAB+AAAAfwAAAH/4AAB///gAf///AB///gAf//gAD//wAA//4AAP/8AAB//AAAf/AAAD+AAAA/gAAAP4AAAB/AAA="}}, {"name": "Blue Jay", "sci": "Cyanocitta cristata", "n": 8, "first": "9:20 AM", "last": "1:31 PM", "ts": 1793107204, "mins": [560, 565, 580, 593, 595, 595, 810, 811], "anim": null, "trunk": false, "fact": "That blue isn’t a pigment. Tiny structures in the feathers scatter light, which is why a crushed blue feather looks brown. Jays also bury acorns and help spread oak trees.", "vox": "sounds/voice/cyanocitta-cristata.mp3?v=1793112993", "snd": "sounds/cyanocitta-cristata.mp3?v=1793113328", "sndby": "Christopher McPherson, xeno-canto XC691163, CC BY-NC-SA 4.0", "key": "bluejay", "cm": 28.0, "img": "cutouts/bluejay.png", "w": 385, "h": 369, "len": 474.0, "beak": [0.99, 0.17, "R"], "mask": {"c": 32, "r": 31, "b": "AAAPAAAAD+AAAAfwAAAH+AAAD/4AAA//AAAf/gAAf/AAAP/wAAH/8AAD//AAB//wAA//4AAf/+AAP//gAH//zAB//5wA/89wAf+OcAP38MAD9+PgAfh/gAPgHwAHgD4ADwA4AB8AMAA+AGAAPADgAHgAwADwAAAA4AAAAA=="}}, {"name": "Cape May Warbler", "sci": "Setophaga tigrina", "n": 1, "first": "9:21 AM", "last": "9:21 AM", "ts": 1793107268, "mins": [561], "anim": null, "trunk": false, "fact": "Its tongue is curled into a tiny tube, a built-in straw for sipping nectar and fruit juice. It nests in northern spruce forests and is named for Cape May, New Jersey, where one of the first specimens was collected.", "vox": "sounds/voice/setophaga-tigrina.mp3?v=1793113044", "snd": "sounds/setophaga-tigrina.mp3?v=1793113195", "sndby": "Steve Pelikan, xeno-canto XC44424, CC BY-NC-ND 2.5", "life": true, "key": "capemay", "cm": 13.0, "img": "cutouts/capemay.png", "w": 800, "h": 587, "len": 703.0, "beak": [0.1, 0.12, "L"], "mask": {"c": 32, "r": 23, "b": "A+AAAAf4AAAf+AAAB/wADAP+AA8D/gBHA/8BTwP/gfsD/8LyA//f8AP//+AB//zgAP/8AAB/9AAAP/gADT/8AAf+PgAH/B4AB+gPAB/AB8A5gALAcAAAAEAAAAA="}}, {"name": "Canada Goose", "sci": "Branta canadensis", "n": 2, "first": "10:00 AM", "last": "10:01 AM", "ts": 1793109658, "mins": [600, 601], "anim": null, "trunk": false, "fact": "Flying in a V lets geese behind get a lift from the bird in front, and they take turns leading.", "vox": "sounds/voice/branta-canadensis.mp3?v=1793112974",