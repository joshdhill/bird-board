{"birds": [{"name": "House Finch", "sci": "Haemorhous mexicanus", "n": 70, "first": "10:09 AM", "last": "1:45 PM", "ts": 1793455782, "mins": [609, 610, 610, 611, 611, 612, 612, 612, 616, 633, 641, 642, 643, 646, 650, 656, 657, 657, 657, 658, 662, 663, 666, 666, 705, 707, 709, 709, 710, 710, 710, 711, 712, 716, 717, 717, 717, 721, 730, 730, 730, 731, 732, 732, 733, 733, 733, 733, 734, 735, 738, 738, 739, 740, 740, 792, 792, 793, 793, 794, 794, 795, 795, 796, 796, 797, 797, 821, 821, 825], "anim": null, "trunk": false, "fact": "Native to the West, house finches were released on Long Island in 1940 as pet-shop “Hollywood finches” and spread across the East. Redder males are favored by females.", "vox": "sounds/voice/haemorhous-mexicanus.mp3?v=1793113005", "snd": "sounds/haemorhous-mexicanus.mp3?v=1793113108", "sndby": "Ted Floyd, xeno-canto XC622745, CC BY-NC-SA 4.0", "key": "housefinch", "cm": 14.0, "img": "cutouts/housefinch.png", "w": 800, "h": 581, "len": 662.0, "beak": [0.12, 0.13, "L"], "mask": {"c": 32, "r": 23, "b": "B+AAAAfwAQoP8AHOH/gB7wf8Af8D/gH/B/8A3wf/AP4H/4zgB//fwAP/zwAD//4AAf/+AAD//AAAf/gAAD/8AA/+/AAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "Tufted Titmouse", "sci": "Baeolophus bicolor", "n": 1, "first": "10:11 AM", "last": "10:11 AM", "ts": 1793455887, "mins": [611], "anim": null, "trunk": false, "fact": "Titmice line their nests with hair, and they have been seen plucking it from live raccoons, dogs, and even people.", "vox": "sounds/voice/baeolophus-bicolor.mp3?v=1793112971", "snd": "sounds/baeolophus-bicolor.mp3?v=1793113083", "sndby": "Jim Berry, xeno-canto XC649331, CC BY-NC-SA 4.0", "key": "titmouse", "cm": 16.5, "img": "cutouts/titmouse.png", "w": 574, "h": 800, "len": 653.0, "beak": [0.2, 0.25, "L"], "mask": {"c": 32, "r": 45, "b": "cAAAAHAAAAAwAAAAIAAAAGgDAAB8B4AAPB8AAD5/AAA+/4AAeP+AAHv/wAB7/8AA+P/gAPhn4ACbH/AADz/wAA9/+AAPf/wABb/8AB+//gAO//4ABt//AAfP/wAHx/+AB+P/gAPh/8AHiP/AB47/wAeH/+AHofvgBvOB8AD3APgAfAB4APgAPAD4AB4A+AAfAPwADwA3AA8APwAHAD4AAAAfAAAAGwAAABgAAAAMAAAADAAA"}}, {"name": "American Goldfinch", "sci": "Spinus tristis", "n": 3, "first": "10:11 AM", "last": "1:03 PM", "ts": 1793455906, "mins": [611, 711, 783], "anim": null, "trunk": false, "fact": "One of the strictest vegetarians among birds. Goldfinches nest late in summer, when thistle seeds are ripe, and swap bright yellow for olive-brown in winter.", "vox": "sounds/voice/spinus-tristis.mp3?v=1793113053", "snd": "sounds/spinus-tristis.mp3?v=1793113090", "sndby": "Will Sweet, xeno-canto XC453934, CC BY-NC-SA 4.0", "key": "goldfinch", "cm": 12.0, "img": "cutouts/goldfinch.png", "w": 517, "h": 369, "len": 415.0, "beak": [0.18, 0.15, "L"], "mask": {"c": 32, "r": 23, "b": "APgAAAH4AAAD/AAAB/wAAAP+AAEB/wAHAf+ADgH/wBwB/8DwAf/h4AH/94AA//8AAH/8ABA/+AAAH/wAAB/+AAA/fhAAeA8AA/gHgAfgB8APAANAPAAAADgAAAA="}}, {"name": "Eastern Bluebird", "sci": "Sialia sialis", "n": 11, "first": "10:14 AM", "last": "1:40 PM", "ts": 1793456075, "mins": [614, 616, 617, 618, 630, 690, 692, 692, 693, 694, 820], "anim": null, "trunk": false, "fact": "Bluebirds nest in tree cavities, and their numbers crashed in the early 1900s when starlings and house sparrows took the holes. Volunteer nest-box trails helped them rebound.", "vox": "sounds/voice/sialia-sialis.mp3?v=1793113046", "snd": "sounds/sialia-sialis.mp3?v=1793113130", "sndby": "Robin Carter, xeno-canto XC1374, CC BY-NC-ND 2.5", "key": "bluebird", "cm": 18.0, "img": "cutouts/bluebird.png", "w": 800, "h": 609, "len": 744.0, "beak": [0.69, 0.1, "R"], "mask": {"c": 32, "r": 24, "b": "AAPwAAAH/AAAD/4AAA/4AAAf8AAAH/AAAD/wAAB/+AAAf/gDAP/wDgH/8BwD//B4A//h4Af/54AH/94AD/98AB//4AA/P4AAPH0AAHPhAABvgAAA3gAAAPgAAABwAAAA"}}, {"name": "White-throated Sparrow", "sci": "Zonotrichia albicollis", "n": 4, "first": "10:17 AM", "last": "1:45 PM", "ts": 1793456266, "mins": [617, 619, 636, 825], "anim": null, "trunk": false, "fact": "White-throats come in two color forms, white-striped and tan-striped, and almost always pair with the opposite form. Listen for “Oh-sweet-Canada, Canada, Canada.”", "vox": "sounds/voice/zonotrichia-albicollis.mp3?v=1793113071", "snd": "sounds/zonotrichia-albicollis.mp3?v=1793113140", "sndby": "Matt Wistrand, xeno-canto XC339648, CC BY-NC-SA 4.0", "key": "whitethroated", "cm": 17.0, "img": "cutouts/whitethroated.png", "w": 800, "h": 460, "len": 599.0, "beak": [0.73, 0.14, "R"], "mask": {"c": 32, "r": 18, "b": "AAB+AAAB/gAAB/8DAB/+BwB//h4B//54f//84P///8AAP/8AAA/8AAAD8AAAA/AAAA8AAAA/AAAAeAAAAeAAAAeAAAAHAAAA"}}, {"name": "Corvus corax", "sci": "Corvus corax", "n": 1, "first": "10:19 AM", "last": "10:19 AM", "ts": 1793456390, "mins": [619], "anim": null, "trunk": false, "vox": "sounds/voice/corvus-corax.mp3?v=1793456433", "snd": "sounds/corvus-corax.mp3?v=1793456431", "sndby": "Richard E. Webster, xeno-canto XC662953, CC BY-NC-SA 4.0", "life": true, "key": "ph-corvuscorax", "ph": true, "cm": 15, "img": "", "w": 560, "h": 440, "len": 470}, {"name": "Fish Crow", "sci": "Corvus ossifragus", "n": 1, "first": "10:34 AM", "last": "10:34 AM", "ts": 1793457272, "mins": [634], "anim": null, "trunk": false, "fact": "It looks just like an American Crow. The giveaway is the voice: a nasal, two-note “uh-uh” instead of a clear “caw.”", "vox": "sounds/voice/corvus-ossifragus.mp3?v=1793112991", "snd": "sounds/corvus-ossifragus.mp3?v=1793113105", "sndby": "Mike Nelson, xeno-canto XC130581, CC BY-NC-SA 3.0", "key": "fishcrow", "cm": 38.0, "img": "cutouts/fishcrow.png", "w": 800, "h": 474, "len": 557.0, "beak": [0.27, 0.08, "L"], "mask": {"c": 32, "r": 19, "b": "AH4AAAD+AAAAPwAAAB+AAAAf4AAAH/AAAB/4AAAf/gAAD/4AAAf/AAAD/4AAAf/AAAD34P8Bs+D///Dg/////v////8AD///AAAP/w=="}}, {"name": "Astur cooperii", "sci": "Astur cooperii", "n": 1, "first": "10:42 AM", "last": "10:42 AM", "ts": 1793457764, "mins": [642], "anim": null, "trunk": false, "vox": "sounds/voice/astur-cooperii.mp3?v=1793457820", "life": true, "key": "ph-asturcooperii", "ph": true, "cm": 15, "img": "", "w": 560, "h": 440, "len": 470}, {"name": "Dark-eyed Junco", "sci": "Junco hyemalis", "n": 7, "first": "10:44 AM", "last": "12:53 PM", "ts": 1793457887, "mins": [644, 667, 685, 686, 708, 731, 773], "anim": null, "trunk": false, "fact": "Often called “snowbirds” because they show up as winter arrives. The white outer tail feathers flash as they flit away.", "vox": "sounds/voice/junco-hyemalis.mp3?v=1793113009", "snd": "sounds/junco-hyemalis.mp3?v=1793113154", "sndby": "Phoenix Birder, xeno-canto XC563632, CC BY-NC-SA 4.0", "key": "junco", "cm": 15.5, "img": "cutouts/junco.png", "w": 800, "h": 562, "len": 625.0, "beak": [0.2, 0.22, "L"], "mask": {"c": 32, "r": 22, "b": "AAAABgAAAAYA8AAMAfgAOAP8ADAD/gBxAf8AZwH/gMwB/8G4Af/j8AD/94AA//4AAH/8AAA//gAAH/4AAAf/AAQPh4AEPwHABfgA4A/QAHA+AAAA8AAAAA=="}}, {"name": "American Crow", "sci": "Corvus brachyrhynchos", "n": 4, "first": "10:50 AM", "last": "11:10 AM", "ts": 1793458207, "mins": [650, 650, 661, 670], "anim": null, "trunk": false, "fact": "Crows remember individual human faces for years, and they seem to pass the grudge along to other crows.", "vox": "sounds/voice/corvus-brachyrhynchos.mp3?v=1793112990", "snd": "sounds/corvus-brachyrhynchos.mp3?v=1793113335", "sndby": "David Vander Pluym, xeno-canto XC289011, CC BY-NC-SA 4.0", "key": "crow", "cm": 45.0, "img": "cutouts/crow.png", "w": 553, "h": 364, "len": 568.0, "beak": [0.94, 0.14, "R"], "mask": {"c": 32, "r": 21, "b": "AAAHwAAAD/gAAB/+AAB//gAD/+AAD//AAB//wAB//4AB//+AB///AAf//wAP//4AH//4AH//8AD//8AA/x+AAPgPwAbwF/6/f////3///7Bhw5AA"}}, {"name": "Northern Flicker", "sci": "Colaptes auratus", "n": 1, "first": "11:07 AM", "last": "11:07 AM", "ts": 1793459233, "mins": [667], "anim": null, "trunk": false, "fact": "A woodpecker that often feeds on the ground, mainly on ants. Eastern flickers flash bright yellow under the wings and tail when they fly.", "vox": "sounds/voice/colaptes-auratus.mp3?v=1793112986", "snd": "sounds/colaptes-auratus.mp3?v=1793113157", "sndby": "Thomas Magarian, xeno-canto XC354617, CC BY-NC-SA 4.0", "key": "flicker", "cm": 31.0, "img": "cutouts/flicker.png", "w": 800, "h": 579, "len": 732.0, "beak": [0.66, 0.07, "R"], "mask": {"c": 32, "r": 23, "b": "AA/AAAAP/AAAH/gAAD/AAAB/gAEA/4AHAf+ADgH/wDwD/4DwA/+B4Af/h4AH/x4AD/54AA//4AAf/4AAH98AAD79AAA+8AAAP/AAAH8gAAD+AAAA+AAAAPAAAAA="}}, {"name": "Eastern Towhee", "sci": "Pipilo erythrophthalmus", "n": 1, "first": "11:26 AM", "last": "11:26 AM", "ts": 1793460394, "mins": [686], "anim": null, "trunk": false, "fact": "Towhees scratch through leaf litter with a two-footed hop-and-kick. The song says it all: “drink-your-teeeea.”", "vox": "sounds/voice/pipilo-erythrophthalmus.mp3?v=1793113027", "snd": "sounds/pipilo-erythrophthalmus.mp3?v=1793113162", "sndby": "Ross Gallardy, xeno-canto XC310201, CC BY-NC-SA 4.0", "key": "towhee", "cm": 20.0, "img": "cutouts/towhee.png", "w": 800, "h": 545, "len": 636.0, "beak": [0.64, 0.09, "R"], "mask": {"c": 32, "r": 22, "b": "AAHwAAAD+AAAB/gAAA/wAAAf8AAAP/ADAH/wBgD/8BwB/+B4Af/g8AP/wcAD/8cAA/8eAAf/+AAfE+AAHh+AAD4fgAB8fAAA+PwAAPPAAAAPAAAADgAAAA=="}}, {"name": "Bald Eagle", "sci": "Haliaeetus leucocephalus", "n": 1, "first": "12:27 PM", "last": "12:27 PM", "ts": 1793464021, "mins": [747], "anim": null, "trunk": false, "fact": "Bald Eagles add to the same nest year after year, so some grow into the biggest nests of any North American bird: hundreds of pounds of sticks.", "vox": "sounds/voice/haliaeetus-leucocephalus.mp3?v=1793113008", "snd": "sounds/haliaeetus-leucocephalus.mp3?v=1793113183", "sndby": "Ryan P. O&#039;Donnell, xeno-canto XC81952, CC BY-NC-ND 2.5", "key": "baldeagle", "cm": 63.0, "img": "cutouts/baldeagle.png", "w": 389, "h": 800, "len": 490.0, "beak": [0.02, 0.065, "L"], "mask": {"c": 32, "r": 64, "b": ""}}, {"name": "White-breasted Nuthatch", "sci": "Sitta carolinensis", "n": 1, "first": "1:45 PM", "last": "1:45 PM", "ts": 1793468727, "mins": [825], "anim": null, "trunk": true, "fact": "Nuthatches climb down tree trunks head first. The name comes from “nut-hack”: they wedge a seed into bark and hack it open.", "vox": "sounds/voice/sitta-carolinensis.mp3?v=1793113050", "snd": "sounds/sitta-carolinensis.mp3?v=1793113095", "sndby": "Andrew Spencer, xeno-canto XC14860, CC BY-NC-ND 2.5", "key": "nuthatch", "cm": 14.0, "img": "cutouts/nuthatch.png", "w": 532, "h": 327, "len": 372.0, "beak": [0.79, 0.42, "R"], "mask": {"c": 32, "r": 20, "b": "fgAAAH8AAAB/AAAAP4AAAD+AAAAfwAAAH/4gAB///gAf///AB///gAf//gAD//wAA//4AAP/8AAB//AAAf/AAAD+AAAA/gAAAP4AAAB/AAA="}}], "also": [], "date": "Saturday, October 31", "where": "", "updated": "1:46 PM", "sun": null, "code": "3bb51669b7", "listen": {"state": "on", "since": null, "control": false}}