 "v": 1793045349, "beak": [0.22, 0.14, "L"], "mask": {"c": 32, "r": 19, "b": "APgAAAD8AAAB/gAAAP+AAAD/wAAA/+AAAP/wAAD/+AAAf/wA8H//APg//8B4H//4/o/yvP//x89//8///f///z3h//854A7/AYAAww=="}}, {"name": "Rock Pigeon", "sci": "Columba livia", "n": 1, "first": "10:44 AM", "last": "10:44 AM", "ts": 1794671088, "mins": [644], "anim": null, "trunk": false, "fact": "Pigeons have been domesticated for thousands of years, and homing pigeons can find their way back across hundreds of miles.", "vox": "sounds/voice/columba-livia.mp3?v=1793986166", "snd": "sounds/columba-livia.mp3?v=1793113284", "sndby": "Paul Marvin, xeno-canto XC485507, CC BY-NC-SA 4.0", "life": true, "key": "rockpigeon", "cm": 32.0, "img": "cutouts/rockpigeon.png?v=1793987498", "w": 800, "h": 544, "len": 872.0, "v": 1793987498, "beak": [0.994, 0.201, "R"], "mask": {"c": 32, "r": 22, "b": "AAAAPgAAAH4AAAB+AAAA/wAAB/0AAD/8AAD//AAB//wAB//8AA///AAf//wAP//8A///+AP///gB///wA///wA/h/wA+AB4A+AD/4OAA/+AAAP/gAAD/4A=="}}], "also": [], "date": "Saturday, November 14", "where": "", "updated": "10:45 AM", "sun": null, "wx": {"t": 45, "kind": "cloudy", "word": "Cloudy", "hi": 48, "lo": 38}, "code": "10a791c1d1", "listen": {"state": "on", "since": null, "control": false}}