{"birds": [{"name": "House Finch", "sci": "Haemorhous mexicanus", "n": 28, "first": "1:04 PM", "last": "3:38 PM", "ts": 1794852249, "mins": [784, 784, 785, 787, 787, 788, 812, 820, 832, 874, 874, 876, 889, 903, 906, 907, 907, 908, 912, 912, 913, 923, 924, 926, 929, 937, 937, 938], "anim": null, "trunk": false, "fact": "Native to the West, house finches were released on Long Island in 1940 as pet-shop “Hollywood finches” and spread across the East. Redder males are favored by females.", "vox": "sounds/voice/haemorhous-mexicanus.mp3?v=1793113005", "snd": "sounds/haemorhous-mexicanus.mp3?v=1793113108", "sndby": "Ted Floyd, xeno-canto XC622745, CC BY-NC-SA 4.0", "key": "housefinch", "cm": 14.0, "img": "cutouts/housefinch.png?v=1793046043", "w": 800, "h": 581, "len": 662.0, "v": 1793046043, "beak": [0.12, 0.13, "L"], "mask": {"c": 32, "r": 23, "b": "B+AAAAfwAQoP8AHOH/gB7wf8Af8D/gH/B/8A3wf/AP4H/4zgB//fwAP/zwAD//4AAf/+AAD//AAAf/gAAD/8AA/+/AAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "Bald Eagle", "sci": "Haliaeetus leucocephalus", "n": 7, "first": "1:11 PM", "last": "2:38 PM", "ts": 1794852694, "mins": [791, 793, 793, 803, 817, 836, 878], "anim": null, "trunk": false, "fact": "Bald Eagles add to the same nest year after year, so some grow into the biggest nests of any North American bird: hundreds of pounds of sticks.", "vox": "sounds/voice/haliaeetus-leucocephalus.mp3?v=1793113008", "snd": "sounds/haliaeetus-leucocephalus.mp3?v=1793113183", "sndby": "Ryan P. O&#039;Donnell, xeno-canto XC81952, CC BY-NC-ND 2.5", "key": "baldeagle", "cm": 63.0, "img": "cutouts/baldeagle.png?v=1793977259", "w": 383, "h": 577, "len": 490.0, "v": 1793977259, "beak": [0.012, 0.085, "L"], "mask": {"c": 32, "r": 48, "b": "D8AAAB/gAAB/8AAA//AAAP/4AAD//AAAh/8AAAP/wAAD//gAA//+AAP//4AH///AD///4A///+AP///wD///8A////gP///4B///+Af///wD///8A////AH///wA///8AD///gAf//4AD//8AA+//AAPP/4AB3/+AAf//wAH//8AB///AA/6fwAP+AAAD/gAAA/8AAAH/AAAD/wAAAf8AAAH+AAAB/gAAAf4AAAH/AAAB/wAAAP8AAAAAAAAAAAA"}}, {"name": "White-breasted Nuthatch", "sci": "Sitta carolinensis", "n": 7, "first": "1:17 PM", "last": "3:02 PM", "ts": 1794853057, "mins": [797, 797, 803, 804, 804, 863, 902], "anim": null, "trunk": true, "fact": "Nuthatches climb down tree trunks head first. The name comes from “nut-hack”: they wedge a seed into bark and hack it open.", "vox": "sounds/voice/sitta-carolinensis.mp3?v=1793113050", "snd": "sounds/sitta-carolinensis.mp3?v=1793113095", "sndby": "Andrew Spencer, xeno-canto XC14860, CC BY-NC-ND 2.5", "key": "nuthatch", "cm": 14.0, "img": "cutouts/nuthatch.png?v=1793031430", "w": 532, "h": 327, "len": 372.0, "v": 1793031430, "beak": [0.79, 0.42, "R"], "mask": {"c": 32, "r": 20, "b": "fgAAAH8AAAB/AAAAP4AAAD+AAAAfwAAAH/4gAB///gAf///AB///gAf//gAD//wAA//4AAP/8AAB//AAAf/AAAD+AAAA/gAAAP4AAAB/AAA="}}, {"name": "American Crow", "sci": "Corvus brachyrhynchos", "n": 25, "first": "1:31 PM", "last": "3:38 PM", "ts": 1794853867, "mins": [811, 811, 812, 814, 816, 816, 817, 817, 818, 818, 819, 819, 820, 820, 821, 821, 821, 822, 822, 835, 898, 907, 926, 927, 938], "anim": null, "trunk": false, "fact": "Crows remember individual human faces for years, and they seem to pass the grudge along to other crows.", "vox": "sounds/voice/corvus-brachyrhynchos.mp3?v=1793112990", "snd": "sounds/corvus-brachyrhynchos.mp3?v=1793113335", "sndby": "David Vander Pluym, xeno-canto XC289011, CC BY-NC-SA 4.0", "key": "crow", "cm": 45.0, "img": "cutouts/crow.png?v=1793031428", "w": 553, "h": 364, "len": 568.0, "v": 1793031428, "beak": [0.94, 0.14, "R"], "mask": {"c": 32, "r": 21, "b": "AAAHwAAAD/gAAB/+AAB//gAD/+AAD//AAB//wAB//4AB//+AB///AAf//wAP//4AH//4AH//8AD//8AA/x+AAPgPwAbwF/6/f////3///7Bhw5AA"}}, {"name": "Dark-eyed Junco", "sci": "Junco hyemalis", "n": 5, "first": "1:47 PM", "last": "3:16 PM", "ts": 1794854838, "mins": [827, 887, 889, 902, 916], "anim": null, "trunk": false, "fact": "Often called “snowbirds” because they show up as winter arrives. The white outer tail feathers flash as they flit away.", 