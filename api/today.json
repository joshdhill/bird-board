, "R"], "mask": {"c": 32, "r": 21, "b": "AAAHwAAAD/gAAB/+AAB//gAD/+AAD//AAB//wAB//4AB//+AB///AAf//wAP//4AH//4AH//8AD//8AA/x+AAPgPwAbwF/6/f////3///7Bhw5AA"}}, {"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 2, "first": "11:42 AM", "last": "11:43 AM", "ts": 1795797721, "mins": [702, 703], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png?v=1793045350", "w": 486, "h": 800, "len": 707.0, "v": 1793045350, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAP/4AAD//AAA//wAAP/8IAD//DwA//wf4H/8D/x//Af+f/wH/3/8A/9//AP/f/wD/3/8B/9//A//f/wf/n/8P/x//H/8f/7//H/+//x////8f////D////x////8f////H////h////4f///+D////A////wP///4D///+A////gP///wD///8A///+AP///gD///wA///4AP//+AD///AA///wAP//sAD//4AA//8AAP//AAD//wAA//4AAP/+AAD//gAA//4AAP/8AAD//AAA="}}, {"name": "Carolina Chickadee", "sci": "Poecile carolinensis", "n": 2, "first": "11:42 AM", "last": "11:43 AM", "ts": 1795797774, "mins": [702, 703], "anim": null, "trunk": false, "fact": "Chickadees hide seeds in many separate spots and can remember where for weeks, then dig them back out when food gets scarce.", "vox": "sounds/voice/poecile-carolinensis.mp3?v=1793113028", "snd": "sounds/poecile-carolinensis.mp3?v=1793113078", "sndby": "J.R. Rigby, xeno-canto XC309925, CC BY-NC-SA 4.0", "key": "chickadee", "cm": 12.5, "img": "cutouts/chickadee.png?v=1793046043", "w": 686, "h": 800, "len": 829.0, "v": 1793046043, "beak": [0.78, 0.05, "R"], "mask": {"c": 32, "r": 37, "b": "AAB+AQAA/8MAAf+DAAP/gwAD/wYAA/8GAAf/PAAH/7wAB//8AA//+AAf//4AH/+/AD//vwA//38Af/98AP//5AD//sAA//3AAf/9gAH//4AD//+AA///gAf//4APg/wADgH8ABwA+AA4APgAeAH4AHAB8ADgA/AAwAeAAMAPAAAAHwAAADwAAAA8AAAAeAA