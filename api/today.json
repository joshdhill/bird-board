{"birds": [{"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 1, "first": "9:42 AM", "last": "9:42 AM", "ts": 1793976146, "mins": [582], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png", "w": 486, "h": 800, "len": 707.0, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAP/4AAD//AAA//wAAP/8IAD//DwA//wf4H/8D/x//Af+f/wH/3/8A/9//AP/f/wD/3/8B/9//A//f/wf/n/8P/x//H/8f/7//H/+//x////8f////D////x////8f////H////h////4f///+D////A////wP///4D///+A////gP///wD///8A///+AP///gD///wA///4AP//+AD///AA///wAP//sAD//4AA//8AAP//AAD//wAA//4AAP/+AAD//gAA//4AAP/8AAD//AAA="}}, {"name": "Fish Crow", "sci": "Corvus ossifragus", "n": 2, "first": "9:42 AM", "last": "9:42 AM", "ts": 1793976159, "mins": [582, 582], "anim": null, "trunk": false, "fact": "It looks just like an American Crow. The giveaway is the voice: a nasal, two-note “uh-uh” instead of a clear “caw.”", "vox": "sounds/voice/corvus-ossifragus.mp3?v=1793112991", "snd": "sounds/corvus-ossifragus.mp3?v=1793113105", "sndby": "Mike Nelson, xeno-canto XC130581, CC BY-NC-SA 3.0", "key": "fishcrow", "cm": 38.0, "img": "cutouts/fishcrow.png", "w": 800, "h": 474, "len": 557.0, "beak": [0.27, 0.08, "L"], "mask": {"c": 32, "r": 19, "b": "AH4AAAD+AAAAPwAAAB+AAAAf4AAAH/AAAB/4AAAf/gAAD/4AAAf/AAAD/4AAAf/AAAD34P8Bs+D///Dg/////v////8AD///AAAP/w=="}}, {"name": "Northern Cardinal", "sci": "Cardinalis cardinalis", "n": 3, "first": "9:45 AM", "last": "9:46 AM", "ts": 1793976312, "mins": [585, 585, 586], "anim": null, "trunk": false, "fact": "Female cardinals sing too, which is unusual for a North American songbird. During courtship the male feeds her seeds beak to beak.", "v