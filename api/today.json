{"birds": [{"name": "House Finch", "sci": "Haemorhous mexicanus", "n": 9, "first": "10:09 AM", "last": "10:16 AM", "ts": 1793455782, "mins": [609, 610, 610, 611, 611, 612, 612, 612, 616], "anim": null, "trunk": false, "fact": "Native to the West, house finches were released on Long Island in 1940 as pet-shop “Hollywood finches” and spread across the East. Redder males are favored by females.", "vox": "sounds/voice/haemorhous-mexicanus.mp3?v=1793113005", "snd": "sounds/haemorhous-mexicanus.mp3?v=1793113108", "sndby": "Ted Floyd, xeno-canto XC622745, CC BY-NC-SA 4.0", "key": "housefinch", "cm": 14.0, "img": "cutouts/housefinch.png", "w": 800, "h": 581, "len": 662.0, "beak": [0.12, 0.13, "L"], "mask": {"c": 32, "r": 23, "b": "B+AAAAfwAQoP8AHOH/gB7wf8Af8D/gH/B/8A3wf/AP4H/4zgB//fwAP/zwAD//4AAf/+AAD//AAAf/gAAD/8AA/+/AAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "Tufted Titmouse", "sci": "Baeolophus bicolor", "n": 1, "first": "10:11 AM", "last": "10:11 AM", "ts": 1793455887, "mins": [611], "anim": null, "trunk": false, "fact": "Titmice line their nests with hair, and they have been seen plucking it from live raccoons, dogs, and even people.", "vox": "sounds/voice/baeolophus-bicolor.mp3?v=1793112971", "snd": "sounds/baeolophus-bicolor.mp3?v=1793113083", "sndby": "Jim Berry, xeno-canto XC649331, CC BY-NC-SA 4.0", "key": "titmouse", "cm": 16.5, "img": "cutouts/titmouse.png", "w": 574, "h": 800, "len": 653.0, "beak": [0.2, 0.25, "L"], "mask": {"c": 32, "r": 45, "b": "cAAAAHAAAAAwAAAAIAAAAGgDAAB8B4AAPB8AAD5/AAA+/4AAeP+AAHv/wAB7/8AA+P/gAPhn4ACbH/AADz/wAA9/+AAPf/wABb/8AB+//gAO//4ABt//AAfP/wAHx/+AB+P/gAPh/8AHiP/AB47/wAeH/+AHofvgBvOB8AD3APgAfAB4APgAPAD4AB4A+AAfAPwADwA3AA8APwAHAD4AAAAfAAAAGwAAABgAAAAMAAAADAAA"}}, {"name": "American Goldfinch", "sci": "Spinus tristis", "n": 1, "first": "10:11 AM", "last": "10:11 AM", "ts": 1793455906, "mins": [611], "anim": null, "trunk": false, "fact": "One of the strictest vegetarians among birds. Goldfinches nest late in summer, when thistle seeds are ripe, and swap bright yellow for olive-brown in winter.", "vox": "sounds/voice/spinus-tristis.mp3?v=1793113053", "snd": "sounds/spinus-tristis.mp3?v=1793113090", "sndby": "Will Sweet, xeno-canto XC453934, CC BY-NC-SA 4.0", "key": "goldfinch", "cm": 12.0, "img": "cutouts/goldfinch.png", "w": 517, "h": 369, "len": 415.0, "beak": [0.18, 0.15, "L"], "mask": {"c": 32, "r": 23, "b": "APgAAAH4AAAD/AAAB/wAAAP+AAEB/wAHAf+ADgH/wBwB/8DwAf/h4AH/94AA//8AAH/8ABA/+AAAH/wAAB/+AAA/fhAAeA8AA/gHgAfgB8APAANAPAAAADgAAAA="}}, {"name": "Eastern Bluebird", "sci": "Sialia sialis", "n": 4, "first": "10:14 AM", "last": "10:18 AM", "ts": 1793456075, "mins": [614, 616, 617, 618], "anim": null, "trunk": false, "fact": "Bluebirds nest in tree cavities, and their numbers crashed in the early 1900s when starlings and house sparrows took the holes. Volunteer nest-box trails helped them rebound.", "vox": "sounds/voice/sialia-sialis.mp3?v=1793113046", "snd": "sounds/sialia-sialis.mp3?v=1793113130", "sndby": "Robin Carter, xeno-canto XC1374, CC BY-NC-ND 2.5", "key": "bluebird", "cm": 18.0, "img": "cutouts/bluebird.png", "w": 800, "h": 609, "len": 744.0, "beak": [0.69, 0.1, "R"], "mask": {"c": 32, "r": 24, "b": "AAPwAAAH/AAAD/4AAA/4AAAf8AAAH/AAAD/wAAB/+AAAf/gDAP/wDgH/8BwD//B4A//h4Af/54AH/94AD/98AB//4AA/P4AAPH0AAHPhAABvgAAA3gAAAPgAAABwAAAA"}}, {"name": "White-throated Sparrow", "sci": "Zonotrichia albicollis", "n": 2, "first": "10:17 AM", "last": "10:19 AM", "ts": 1793456266, "mins": [617, 619], "anim": null, "trunk": false, "fact": "White-throats come in two color forms, white-striped and tan-striped, and almost always pair with the opposite form. Listen for “Oh-sweet-Canada, Canada, Canada.”", "vox": "sounds/voice/zonotrichia-albicollis.mp3?v=1793113071", "snd": "sounds/zonotrichia-albicollis.mp3?v=1793113140", "sndby": "Matt Wistrand, xeno-canto XC339648, CC BY-NC-SA 4.0", "key": "whitethroated", "cm": 17.0, "img": "cutouts/whitethroated.png", "w": 800, "h": 460, "len": 599.0, "beak": [0.73, 0