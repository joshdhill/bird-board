o", "cm": 15.5, "img": "cutouts/junco.png", "w": 800, "h": 562, "len": 625.0, "beak": [0.2, 0.22, "L"], "mask": {"c": 32, "r": 22, "b": "AAAABgAAAAYA8AAMAfgAOAP8ADAD/gBxAf8AZwH/gMwB/8G4Af/j8AD/94AA//4AAH/8AAA//gAAH/4AAAf/AAQPh4AEPwHABfgA4A/QAHA+AAAA8AAAAA=="}}, {"name": "Boat-tailed Grackle", "sci": "Quiscalus major", "n": 1, "first": "10:05 AM", "last": "10:05 AM", "ts": 1793718347, "mins": [605], "anim": null, "trunk": false, "vox": "sounds/voice/quiscalus-major.mp3?v=1793723065", "snd": "sounds/quiscalus-major.mp3?v=1793718392", "sndby": "William Whitehead, xeno-canto XC502114, CC BY-NC-SA 4.0", "life": true, "key": "boattailed", "cm": 42.0, "img": "cutouts/boattailed.png", "w": 539, "h": 800, "len": 854.0, "beak": [0.009, 0.058, "L"], "mask": {"c": 32, "r": 47, "b": "B/AAAH/4AAD/+AAAP/wAAAf+AAAD/gAAAf8AAAP/gAAD/8AAA//gAAP/8AAD//gAA//8AAH//AAB//4AAf//AAT//4AG//+AD3//wBu//8Azn//gA8//4Af//+AE///wDPj/+Ax47/gMOG/8DBjH9AwMw/AIPYP4CD+B/Bg/gfwQLwH+EC+B/hB/wP8Af8D/AHnA/wBZwP8AWcD/AFjAfwAY4H4AGGB+ABhgfgAYYHwACHA8AAgwCAAAMAA="}}, {"name": "Common Grackle", "sci": "Quiscalus quiscula", "n": 1, "first": "10:56 AM", "last": "10:56 AM", "ts": 1793721403, "mins": [656], "anim": null, "trunk": false, "fact": "Its glossy head can flash purple, bronze or green. Inside the bill is a hard ridge that works like a saw to crack open acorns.", "vox": "sounds/voice/quiscalus-quiscula.mp3?v=1793113030", "snd": "sounds/quiscalus-quiscula.mp3?v=1793113135", "sndby": "Chris Parrish, xeno-canto XC20559, CC BY-NC-ND 2.5", "key": "grackle", "cm": 31.0, "img": "cutouts/grackle.png", "w": 800, "h": 558, "len": 705.0, "beak": [0.72, 0.14, "R"], "mask": {"c": 32, "r": 22, "b": "AAAAAQAAMAMAAP4GAAD/HwAB+B4AB/A4AA/4MAAf+HAAf/DAAP/xgAH/5wAD/+YAB//OAA//GAAP3/AAPhjgAHwN4ADwD4AA8G8AAMB+AAAA8AAAAcAAAA=="}}, {"name": "Red-tailed Hawk", "sci": "Buteo jamaicensis", "n": 1, "first": "11:06 AM", "last": "11:06 AM", "ts": 1793721994, "mins": [666], "anim": null, "trunk": false, "fact": "That fierce scream used 