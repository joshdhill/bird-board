{"birds": [{"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 8, "first": "9:42 AM", "last": "2:48 PM", "ts": 1793976146, "mins": [582, 588, 591, 599, 643, 746, 831, 888], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png?v=1793045350", "w": 486, "h": 800, "len": 707.0, "v": 1793045350, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAP/4AAD//AAA//wAAP/8IAD//DwA//wf4H/8D/x//Af+f/wH/3/8A/9//AP/f/wD/3/8B/9//A//f/wf/n/8P/x//H/8f/7//H/+//x////8f////D////x////8f////H////h////4f///+D////A////wP///4D///+A////gP///wD///8A///+AP///gD///wA///4AP//+AD///AA///wAP//sAD//4AA//8AAP//AAD//wAA//4AAP/+AAD//gAA//4AAP/8AAD//AAA="}}, {"name": "Fish Crow", "sci": "Corvus ossifragus", "n": 40, "first": "9:42 AM", "last": "1:50 PM", "ts": 1793976159, "mins": [582, 582, 591, 591, 592, 592, 592, 593, 593, 594, 594, 595, 606, 607, 803, 804, 804, 804, 805, 805, 806, 806, 806, 807, 807, 808, 808, 809, 809, 810, 810, 810, 811, 813, 819, 820, 822, 827, 829, 830], "anim": null, "trunk": false, "fact": "It looks just like an American Crow. The giveaway is the voice: a nasal, two-note “uh-uh” instead of a clear “caw.”", "vox": "sounds/voice/corvus-ossifragus.mp3?v=1793112991", "snd": "sounds/corvus-ossifragus.mp3?v=1793113105", "sndby": "Mike Nelson, xeno-canto XC130581, CC BY-NC-SA 3.0", "key": "fishcrow", "cm": 38.0, "img": "cutouts/fishcrow.png?v=1793990894", "w": 484, "h": 472, "len": 557.0, "v": 1793990894, "beak": [0.021, 0.08, "L"], "mask": {"c": 32, "r": 31, "b": "D4AAAH/AAAD/4AAAf/AAAA/4AAAH/AAAB/4AAAf/gAAH/8AAB//gAAf/+AAH//wAA//+AAH//wAB//+AAP//gAA//8AAH//gAA//+AAHZ/wAB2P8AA5h+AAcwP4f/uA+P//+Dj////4////+P///