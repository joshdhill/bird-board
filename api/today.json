{"birds": [{"name": "Carolina Chickadee", "sci": "Poecile carolinensis", "n": 3, "first": "12:27 PM", "last": "12:29 PM", "ts": 1795282045, "mins": [747, 748, 749], "anim": null, "trunk": false, "fact": "Chickadees hide seeds in many separate spots and can remember where for weeks, then dig them back out when food gets scarce.", "vox": "sounds/voice/poecile-carolinensis.mp3?v=1793113028", "snd": "sounds/poecile-carolinensis.mp3?v=1793113078", "sndby": "J.R. Rigby, xeno-canto XC309925, CC BY-NC-SA 4.0", "key": "chickadee", "cm": 12.5, "img": "cutouts/chickadee.png?v=1793046043", "w": 686, "h": 800, "len": 829.0, "v": 1793046043, "beak": [0.78, 0.05, "R"], "mask": {"c": 32, "r": 37, "b": "AAB+AQAA/8MAAf+DAAP/gwAD/wYAA/8GAAf/PAAH/7wAB//8AA//+AAf//4AH/+/AD//vwA//38Af/98AP//5AD//sAA//3AAf/9gAH//4AD//+AA///gAf//4APg/wADgH8ABwA+AA4APgAeAH4AHAB8ADgA/AAwAeAAMAPAAAAHwAAADwAAAA8AAAAeAAAADAAAA=="}}, {"name": "American Goldfinch", "sci": "Spinus tristis", "n": 9, "first": "12:32 PM", "last": "3:03 PM", "ts": 1795282322, "mins": [752, 862, 863, 863, 864, 864, 865, 889, 903], "anim": null, "trunk": false, "fact": "One of the strictest vegetarians among birds. Goldfinches nest late in summer, when thistle seeds are ripe, and swap bright yellow for olive-brown in winter.", "vox": "sounds/voice/spinus-tristis.mp3?v=1793113053", "snd": "sounds/spinus-tristis.mp3?v=1793113090", "sndby": "Will Sweet, xeno-canto XC453934, CC BY-NC-SA 4.0", "key": "goldfinch", "cm": 12.0, "img": "cutouts/goldfinch.png?v=1793990895", "w": 451, "h": 369, "len": 415.0, "v": 1793990895, "beak": [0.206, 0.15, "L"], "mask": {"c": 32, "r": 26, "b": "ADwAAAD+AAAB/wAAA/8AAAP/gAAA/8AAAH/AAAD/8AAA//AAAP/4DwD/+B4Af/w4AH/+8AA//8AAP/8AAB//AAAH/4AAB//AAA/PwAAeQeAA/gHwAfgA+APIAHwPAAAgHAAAADgAAAA="}}, {"name": "Northern Cardinal", "sci": "Cardinalis cardinalis", "n": 1, "first": "12:32 PM", "last": "12:32 PM", "ts": 1795282357, "mins": [752], "anim": null, "trunk": false, "fact": "Female cardinals sing too, which is unusual for a North American songbird. During courtship the male feeds her seeds beak to beak.", "vox": "sounds/voice/cardinalis-cardinalis.mp3?v=1793112978", "snd": "sounds/cardinalis-cardinalis.mp3?v=1793113085", "sndby": "David Tattersley, xeno-canto XC1000248, CC BY-NC-SA 4.0", "key": "cardinal", "cm": 22.0, "img": "cutouts/cardinal.png?v=1793031428", "w": 516, "h": 348, "len": 530.0, "v": 1793031428, "beak": [0.06, 0.28, "L"], "mask": {"c": 32, "r": 22, "b": "AYAAAAeAAAAPgAAAH4AAAB/AAAA/4AAAf/gAAB/+AAAf/4AAH//AAA//8AAP//gAB//8AAf//AAD//+AAf//wEB/v/jwf3v+///+/z//vn945gA+MAAAAA=="}}, {"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 16, "first": "12:57 PM", "last": "3:42 PM", "ts": 1795283868, "mins": [777, 778, 833, 856, 887, 887, 888, 888, 905, 939, 939, 940, 940, 941, 942, 942], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png?v=1793045350", "w": 486, "h": 800, "len": 707.0, "v": 1793045350, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAP/4AAD//AAA//wAAP/8IAD//DwA//wf4H/8D/x//Af+f/wH/3/8A/9//AP/f/wD/3/8B/9//A//f/wf/n/8P/x//H/8f/7//H/+//x////8f////D////x////8f////H////h////4f///+D////A////wP///4D///+A////gP///wD///8A///+AP///gD///wA///4AP//+AD///AA///wAP//sAD//4AA//8AAP//AAD//wAA//4AAP/+AAD//gAA//4AAP/8AAD//AAA="}}, {"name": "Eastern Bluebird", "sci": "Sialia sialis", "n": 2, "first": "12:58 PM", "last": "3:10 PM", "ts": 1795283927, "mins": [778, 910], "anim": null, "trunk": false, "fact": "Bluebirds nest in tree cavities, and their numbers crashed in the early 1900s when starlings and house sparrows took the holes. Volunteer nest-box trails helped them rebound.", "vox": "sounds/