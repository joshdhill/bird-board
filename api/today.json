{"birds": [{"name": "American Goldfinch", "sci": "Spinus tristis", "n": 21, "first": "2:08 PM", "last": "4:07 PM", "ts": 1794596903, "mins": [848, 867, 911, 925, 927, 927, 928, 929, 929, 930, 930, 938, 939, 939, 940, 944, 948, 966, 966, 967, 967], "anim": null, "trunk": false, "fact": "One of the strictest vegetarians among birds. Goldfinches nest late in summer, when thistle seeds are ripe, and swap bright yellow for olive-brown in winter.", "vox": "sounds/voice/spinus-tristis.mp3?v=1793113053", "snd": "sounds/spinus-tristis.mp3?v=1793113090", "sndby": "Will Sweet, xeno-canto XC453934, CC BY-NC-SA 4.0", "key": "goldfinch", "cm": 12.0, "img": "cutouts/goldfinch.png?v=1793990895", "w": 451, "h": 369, "len": 415.0, "v": 1793990895, "beak": [0.206, 0.15, "L"], "mask": {"c": 32, "r": 26, "b": "ADwAAAD+AAAB/wAAA/8AAAP/gAAA/8AAAH/AAAD/8AAA//AAAP/4DwD/+B4Af/w4AH/+8AA//8AAP/8AAB//AAAH/4AAB//AAA/PwAAeQeAA/gHwAfgA+APIAHwPAAAgHAAAADgAAAA="}}, {"name": "House Finch", "sci": "Haemorhous mexicanus", "n": 24, "first": "2:22 PM", "last": "4:21 PM", "ts": 1794597747, "mins": [862, 863, 863, 863, 869, 874, 878, 906, 910, 918, 928, 940, 944, 952, 952, 953, 954, 954, 955, 962, 965, 966, 980, 981], "anim": null, "trunk": false, "fact": "Native to the West, house finches were released on Long Island in 1940 as pet-shop “Hollywood finches” and spread across the East. Redder males are favored by females.", "vox": "sounds/voice/haemorhous-mexicanus.mp3?v=1793113005", "snd": "sounds/haemorhous-mexicanus.mp3?v=1793113108", "sndby": "Ted Floyd, xeno-canto XC622745, CC BY-NC-SA 4.0", "key": "housefinch", "cm": 14.0, "img": "cutouts/housefinch.png?v=1793046043", "w": 800, "h": 581, "len": 662.0, "v": 1793046043, "beak": [0.12, 0.13, "L"], "mask": {"c": 32, "r": 23, "b": "B+AAAAfwAQoP8AHOH/gB7wf8Af8D/gH/B/8A3wf/AP4H/4zgB//fwAP/zwAD//4AAf/+AAD//AAAf/gAAD/8AA/+/AAH4B4AB+APAB6AD4A4AAeA8AAAAMAAAAA="}}, {"name": "Downy Woodpecker", "sci": "Dryobates pubescens", "n": 10, "first": "2:38 PM", "last": "4:54 PM", "ts": 1794598719, "mins": [878, 893, 893, 1010, 1011, 1011, 1012, 1013, 1013, 1014], "anim": null, "trunk": false, "fact": "North America’s smallest woodpecker. It is small enough to forage on thin weed stalks and twigs that bigger woodpeckers can’t cling to.", "vox": "sounds/voice/dryobates-pubescens.mp3?v=1793112995", "snd": "sounds/dryobates-pubescens.mp3?v=1793113092", "sndby": "Thomas G. Graves, xeno-canto XC89855, CC BY-NC-ND 2.5", "key": "downy", "cm": 16.0, "img": "cutouts/downy.png?v=1793045350", "w": 486, "h": 800, "len": 707.0, "v": 1793045350, "beak": [0.59, 0.1, "L"], "mask": {"c": 32, "r": 53, "b": "AAAAAP/4AAD//AAA//wAAP/8IAD//DwA//wf4H/8D/x//Af+f/wH/3/8A/9//AP/f/wD/3/8B/9//A//f/wf/n/8P/x//H/8f/7//H/+//x////8f////D////x////8f////H////h////4f///+D////A////wP///4D///+A////gP///wD///8A///+AP///gD///wA///4AP//+AD///AA///wAP//sAD//4AA//8AAP//AAD//wAA//4AAP/+AAD//gAA//4AAP/8AAD//AAA="}}, {"name": "Dark-eyed Junco", "sci": "Junco hyemalis", "n": 20, "first": "2:50 PM", "last": "4:40 PM", "ts": 1794599417, "mins": [890, 899, 918, 947, 947, 971, 975, 975, 978, 980, 983, 985, 985, 987, 996, 996, 997, 999, 1000, 1000], "anim": null, "trunk": false, "fact": "Often called “snowbirds” because they show up as winter arrives. The white outer tail feathers flash as they flit away.", "vox": "sounds/voice/junco-hyemalis.mp3?v=1793113009", "snd": "sounds/junco-hyemalis.mp3?v=1793113154", "sndby": "Phoenix Birder, xeno-canto XC563632, CC BY-NC-SA 4.0", "key": "junco", "cm": 15.5, "img": "cutouts/junco.png?v=1793991313", "w": 534, "h": 447, "len": 625.0, "v": 1793991313, "beak": [0.022, 0.14, "L"], "mask": {"c": 32, "r": 27, "b": "D4AAAD/AAAA/4AAA//AAAP/wAAA//AAAH/4AAD//AAA//4AAP//AAD//4AA///AAH//4wB///cAP//+AB///AAf//wAB//+AAP//wAA//8AAH+PgAD8B8AH+AHgD/gA8D+AAHg/gAA8AAAAH"}}, {"name": "Red-bellied Woodpecker", "sci": "Melanerpes carolinus", "n": 4, "first": "3:24 PM", "last": "3:25 PM", "ts": 1794601468, "mins": [924, 924, 924, 925], "anim": null, "trunk": true, "